<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Groq Bubble"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Paste your Groq API key below"
        android:textColor="#B0B0B0"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/apiKeyInput"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="sk-..."
        android:inputType="textPassword"
        android:textColor="#FFFFFF"
        android:textColorHint="#707070"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:layout_marginBottom="16dp"
        android:textSize="14sp" />

    <Button
        android:id="@+id/saveKeyButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Save API Key"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6750A4"
        android:layout_marginBottom="12dp"
        android:textSize="16sp" />

    <Button
        android:id="@+id/startBubbleButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Start Bubble"
        android:textColor="#FFFFFF"
        android:backgroundTint="#4CAF50"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/loadConversationsButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Load Saved Conversations"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF9800"
        android:textSize="16sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="The bubble will float over all apps. Minimize this to use it."
        android:textSize="12sp"
        android:textColor="#909090" />

</LinearLayout>
